{
  "name": "unblok",
  "version": "0.1.0",
  "description": "Unblock your Storyblok operations.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hi-Folks/unblok.git"
  },
  "homepage": "https://github.com/Hi-Folks/unblok#readme",
  "bugs": {
    "url": "https://github.com/Hi-Folks/unblok/issues"
  },
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "unblok": "./index.ts"
  },
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --hot index.ts",
    "test": "bun test",
    "build": "bun run scripts/release/build.ts",
    "buildexe": "bun build ./index.ts --compile --outfile ./dist/unblok",
    "typecheck": "bun check",
    "build:all": "bun run scripts/release/build.ts --all",
    "quality": "bun fmt --check scripts/release/*.ts scripts/release/*.cjs && bun run typecheck && bun test",
    "release:check": "bun run scripts/release/check.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@storyblok/management-api-client": "^0.12.0",
    "@storyblok/region-helper": "^1.7.0",
    "ajv": "^8.20.0",
    "cmd-table": "^1.6.0"
  },
  "license": "MIT"
}
