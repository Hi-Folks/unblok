{
  "name": "unblok",
  "version": "0.1.6",
  "description": "Unblock your Storyblok operations.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hi-Folks/unblok.git"
  },
  "homepage": "https://github.com/Hi-Folks/unblok#readme",
  "bugs": {
    "url": "https://github.com/Hi-Folks/unblok/issues"
  },
  "module": "src/library.ts",
  "exports": {
    ".": "./src/library.ts"
  },
  "type": "module",
  "private": true,
  "bin": {
    "unblok": "./index.ts"
  },
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --hot index.ts",
    "test": "bun test",
    "build": "bun run scripts/release/build.ts",
    "typecheck": "bun check",
    "quality": "bun fmt --check scripts/release/*.ts && bun run typecheck && bun test",
    "release": "bun run scripts/release/prepare.ts",
    "release:check": "bun run scripts/release/check.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@storyblok/management-api-client": "^0.12.0",
    "@storyblok/region-helper": "^1.7.0",
    "ajv": "^8.20.0",
    "cmd-table": "^1.6.0",
    "fast-string-width": "^3.0.2",
    "fast-wrap-ansi": "^0.2.2",
    "yaml": "^2.9.1"
  },
  "license": "MIT"
}
