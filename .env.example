# Create a personal access token at https://app.storyblok.com/#/me/account?tab=token
STORYBLOK_TOKEN=your-personal-access-token

# Optional default for space-scoped commands
# STORYBLOK_SPACE_ID=123456

# Optional region override for space-scoped requests: eu, us, ca, ap, or cn
# STORYBLOK_REGION=eu

# Optional request rate per second (default: 6)
# STORYBLOK_REQUESTS_PER_SECOND=6
