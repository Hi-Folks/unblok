{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unblok.dev/schemas/space-setup-v1.schema.json",
  "title": "unblok space setup blueprint",
  "description": "Supported version 1 setup blueprint fields. Runtime resource checks are performed by unblok.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1, "description": "Blueprint format version." },
    "extends": {
      "description": "Relative blueprint file path or ordered list of paths to merge before this file.",
      "oneOf": [
        { "$ref": "#/$defs/nonempty" },
        { "type": "array", "items": { "$ref": "#/$defs/nonempty" } }
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "owner": { "type": "string" },
        "tags": { "$ref": "#/$defs/strings" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "mode": { "const": "reconcile" } }
    },
    "inputs": {
      "type": "object",
      "description": "String inputs referenced as ${{ inputs.name }}.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "default": { "type": "string" }
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/nonempty" },
        "duplicate_from": { "$ref": "#/$defs/id" },
        "in_org": { "type": "boolean" },
        "demo": { "type": "boolean" },
        "languages": { "$ref": "#/$defs/nonemptyStrings" },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
            "poll_interval_seconds": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "description": "Configure preview URLs; ${{ space.preview_token }} is resolved at runtime.",
      "properties": {
        "enabled": { "type": "boolean" },
        "default": { "$ref": "#/$defs/nonempty" },
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url"],
            "properties": {
              "name": { "$ref": "#/$defs/nonempty" },
              "url": { "$ref": "#/$defs/nonempty" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "properties": { "enabled": { "const": false } },
              "required": ["enabled"]
            }
          },
          "then": { "required": ["default"] }
        }
      ]
    },
    "demo_mode": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "remove": { "type": "boolean" } }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "inherit_org_configuration"],
      "description": "Configure space AI and organization AI inheritance.",
      "properties": {
        "enabled": { "type": "boolean" },
        "inherit_org_configuration": { "type": "boolean" }
      }
    },
    "ai_translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disclaimer_id"],
      "description": "Accept the specified disclaimer and install the AI Translations app.",
      "properties": { "disclaimer_id": { "$ref": "#/$defs/id" } }
    },
    "experiments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disclaimer_id", "create"],
      "properties": {
        "disclaimer_id": { "$ref": "#/$defs/id" },
        "create": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/experiment" }
        }
      }
    },
    "releases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {
        "create": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "$ref": "#/$defs/nonempty" },
              "release_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$"
              },
              "release_in_days": {
                "type": "integer",
                "minimum": 1,
                "maximum": 36500
              }
            },
            "not": { "required": ["release_at", "release_in_days"] }
          }
        }
      }
    },
    "pipelines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {
        "create": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "$ref": "#/$defs/nonempty" },
              "source": { "$ref": "#/$defs/nonempty" }
            }
          }
        }
      }
    },
    "apps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "continue_on_error": { "type": "boolean" },
        "install": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/nonempty" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id"],
                "properties": { "id": { "$ref": "#/$defs/id" } }
              }
            ]
          }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentField" }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upload_directory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target_folder"],
            "properties": {
              "source": { "$ref": "#/$defs/nonempty" },
              "target_folder": { "$ref": "#/$defs/nonempty" },
              "include": { "$ref": "#/$defs/nonemptyStrings" }
            }
          }
        },
        "upload_url": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "target_folder"],
            "properties": {
              "name": { "$ref": "#/$defs/nonempty" },
              "url": { "$ref": "#/$defs/nonempty" },
              "target_folder": { "$ref": "#/$defs/nonempty" },
              "filename": { "$ref": "#/$defs/nonempty" }
            }
          }
        }
      }
    },
    "stories": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "slug", "content"],
            "properties": {
              "name": { "$ref": "#/$defs/nonempty" },
              "slug": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^/]+$"
              },
              "content": {
                "type": "object",
                "required": ["component"],
                "properties": { "component": { "$ref": "#/$defs/nonempty" } },
                "additionalProperties": true
              }
            }
          }
        },
        "update_blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["story_slug", "component", "fields"],
            "properties": {
              "story_slug": { "$ref": "#/$defs/nonempty" },
              "component": { "$ref": "#/$defs/nonempty" },
              "fields": { "type": "object", "minProperties": 1 }
            }
          }
        },
        "translated_slugs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["story_slug", "translations"],
            "properties": {
              "story_slug": { "$ref": "#/$defs/nonempty" },
              "translations": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["slug"],
                  "properties": {
                    "slug": { "$ref": "#/$defs/nonempty" },
                    "name": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assign_unstaged": { "type": "boolean" },
        "stage_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "assign": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stories", "workflow", "stage"],
            "properties": {
              "stories": { "$ref": "#/$defs/selector" },
              "workflow": { "$ref": "#/$defs/nonempty" },
              "stage": { "$ref": "#/$defs/nonempty" }
            }
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stories", "tags"],
        "properties": {
          "stories": { "$ref": "#/$defs/selector" },
          "tags": { "$ref": "#/$defs/nonemptyStrings" }
        }
      }
    }
  },
  "$defs": {
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "display_name", "story_slug", "variants", "results"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "display_name": { "$ref": "#/$defs/nonempty" },
        "story_slug": { "$ref": "#/$defs/nonempty" },
        "activate": {
          "type": "boolean",
          "description": "Publish variant stories and start the experiment."
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/experimentVariant" }
        },
        "results": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "series_label"],
          "properties": {
            "title": { "$ref": "#/$defs/nonempty" },
            "series_label": { "$ref": "#/$defs/nonempty" }
          }
        }
      }
    },
    "experimentVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "display_name", "weight", "is_control", "result"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "display_name": { "$ref": "#/$defs/nonempty" },
        "weight": { "type": "number", "minimum": 0, "maximum": 100 },
        "is_control": { "type": "boolean" },
        "result": { "type": "number" }
      }
    },
    "nonempty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "strings": { "type": "array", "items": { "type": "string" } },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "id": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        { "type": "string", "pattern": "^[0-9]*[1-9][0-9]*$" }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slugs"],
      "properties": { "slugs": { "$ref": "#/$defs/nonemptyStrings" } }
    },
    "componentField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "field", "type"],
      "properties": {
        "component": { "$ref": "#/$defs/nonempty" },
        "field": { "$ref": "#/$defs/nonempty" },
        "type": {
          "enum": [
            "text",
            "textarea",
            "richtext",
            "markdown",
            "number",
            "datetime",
            "boolean",
            "option",
            "options",
            "asset",
            "multiasset",
            "multilink",
            "table",
            "bloks",
            "section",
            "custom"
          ]
        },
        "field_type": { "$ref": "#/$defs/nonempty" },
        "tab": { "$ref": "#/$defs/nonempty" },
        "display_name": { "$ref": "#/$defs/nonempty" },
        "required": { "type": "boolean" },
        "translatable": { "type": "boolean" },
        "customize_toolbar": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "custom" } },
            "required": ["type"]
          },
          "then": { "required": ["field_type"] },
          "else": { "not": { "required": ["field_type"] } }
        },
        {
          "if": { "required": ["customize_toolbar"] },
          "then": { "properties": { "type": { "const": "richtext" } } }
        }
      ]
    }
  }
}
