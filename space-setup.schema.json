{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unblok.dev/schemas/space-setup-v1.schema.json",
  "title": "unblok space setup blueprint",
  "description": "Supported version 1 setup blueprint fields. Runtime resource checks are performed by unblok.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1, "description": "Blueprint format version." },
    "extends": {
      "description": "Relative blueprint file path or ordered list of paths to merge before this file.",
      "oneOf": [
        { "$ref": "#/$defs/nonempty" },
        { "type": "array", "items": { "$ref": "#/$defs/nonempty" } }
      ]
    },
    "template": {
      "type": "object",
      "description": "Metadata describing this setup recipe.",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "owner": { "type": "string" },
        "tags": { "$ref": "#/$defs/strings" }
      }
    },
    "execution": {
      "type": "object",
      "description": "Choose how setup is applied; reconcile preserves matching resources where supported.",
      "additionalProperties": false,
      "properties": { "mode": { "const": "reconcile" } }
    },
    "inputs": {
      "type": "object",
      "description": "String inputs referenced as ${{ inputs.name }}.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "default": { "type": "string" }
        }
      }
    },
    "space": {
      "type": "object",
      "description": "Create or duplicate a space and configure its languages.",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/nonempty" },
        "duplicate_from": {
          "$ref": "#/$defs/id",
          "description": "ID of the source space to duplicate."
        },
        "in_org": { "type": "boolean" },
        "demo": { "type": "boolean" },
        "languages": {
          "$ref": "#/$defs/nonemptyStrings",
          "description": "Language codes to ensure in the space."
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
            "poll_interval_seconds": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "description": "Configure preview URLs; ${{ space.preview_token }} is resolved at runtime.",
      "properties": {
        "enabled": { "type": "boolean" },
        "default": { "$ref": "#/$defs/nonempty" },
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url"],
            "properties": {
              "name": { "$ref": "#/$defs/nonempty" },
              "url": { "$ref": "#/$defs/nonempty" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "properties": { "enabled": { "const": false } },
              "required": ["enabled"]
            }
          },
          "then": { "required": ["default"] }
        }
      ]
    },
    "demo_mode": {
      "type": "object",
      "description": "Control demo mode for the target space.",
      "additionalProperties": false,
      "properties": { "remove": { "type": "boolean" } }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "inherit_org_configuration"],
      "description": "Configure space AI and organization AI inheritance.",
      "properties": {
        "enabled": { "type": "boolean" },
        "inherit_org_configuration": { "type": "boolean" }
      }
    },
    "ai_translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disclaimer_id"],
      "description": "Accept the specified disclaimer and install the AI Translations app.",
      "properties": { "disclaimer_id": { "$ref": "#/$defs/id" } }
    },
    "experiments": {
      "type": "object",
      "description": "Install and configure Experiments, including variants and results.",
      "additionalProperties": false,
      "required": ["disclaimer_id", "create"],
      "properties": {
        "disclaimer_id": { "$ref": "#/$defs/id" },
        "create": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/experiment" }
        }
      }
    },
    "releases": {
      "type": "object",
      "description": "Create or publish Storyblok releases.",
      "additionalProperties": false,
      "anyOf": [{ "required": ["create"] }, { "required": ["publish"] }],
      "properties": {
        "publish": {
          "type": "array",
          "description": "Publish selected releases after earlier setup operations succeed.",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref"],
            "properties": { "ref": { "$ref": "#/$defs/nonempty" } }
          }
        },
        "create": {
          "type": "array",
          "description": "Ensure releases exist by name; an existing release keeps its schedule.",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "$ref": "#/$defs/nonempty" },
              "release_at": {
                "type": "string",
                "description": "Scheduled release date and time in YYYY-MM-DD HH:mm format.",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$"
              },
              "release_in_days": {
                "type": "integer",
                "description": "Schedule relative to creation, in whole days; cannot be combined with release_at.",
                "minimum": 1,
                "maximum": 36500
              }
            },
            "not": { "required": ["release_at", "release_in_days"] }
          }
        }
      }
    },
    "pipelines": {
      "type": "object",
      "description": "Ensure content pipeline stages exist.",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {
        "create": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "$ref": "#/$defs/nonempty" },
              "source": { "$ref": "#/$defs/nonempty" }
            }
          }
        }
      }
    },
    "apps": {
      "type": "object",
      "description": "Install apps and configure supported app settings.",
      "additionalProperties": false,
      "properties": {
        "continue_on_error": { "type": "boolean" },
        "dimensions": {
          "type": "object",
          "description": "Configure which root folders the Dimensions app can use.",
          "additionalProperties": false,
          "required": ["folders"],
          "properties": {
            "folders": {
              "type": "array",
              "description": "Root folder paths to select; replaces the existing Dimensions selection.",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^/*,]+$"
              }
            }
          }
        },
        "install": {
          "type": "array",
          "description": "Apps to install by regional slug or explicit ID; already-installed apps are preserved.",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/nonempty" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id"],
                "properties": { "id": { "$ref": "#/$defs/id" } }
              }
            ]
          }
        }
      }
    },
    "components": {
      "type": "object",
      "description": "Ensure supported fields exist in component schemas.",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentField" }
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "Upload local or remote assets into the space.",
      "additionalProperties": false,
      "properties": {
        "upload_directory": {
          "type": "array",
          "description": "Upload selected files from a local directory into an asset folder.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target_folder"],
            "properties": {
              "source": { "$ref": "#/$defs/nonempty" },
              "target_folder": { "$ref": "#/$defs/nonempty" },
              "include": { "$ref": "#/$defs/nonemptyStrings" }
            }
          }
        },
        "upload_url": {
          "type": "array",
          "description": "Upload assets from URLs into an asset folder.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "target_folder"],
            "properties": {
              "name": { "$ref": "#/$defs/nonempty" },
              "url": { "$ref": "#/$defs/nonempty" },
              "target_folder": { "$ref": "#/$defs/nonempty" },
              "filename": { "$ref": "#/$defs/nonempty" }
            }
          }
        }
      }
    },
    "stories": {
      "type": "object",
      "description": "Create, organize, update, translate, or link story content.",
      "additionalProperties": false,
      "properties": {
        "ai_translate": {
          "type": "array",
          "description": "Request AI translation for selected stories and languages.",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "dependentRequired": { "workflow": ["review_stage"] },
            "allOf": [
              {
                "oneOf": [
                  { "required": ["story_id"] },
                  { "required": ["story_slug"] }
                ]
              },
              {
                "oneOf": [
                  { "required": ["languages"] },
                  { "required": ["all_languages"] }
                ]
              }
            ],
            "properties": {
              "story_id": {
                "oneOf": [
                  { "$ref": "#/$defs/id" },
                  {
                    "type": "string",
                    "pattern": "^\\$\\{\\{\\s*inputs\\.[a-zA-Z_][a-zA-Z0-9_]*\\s*\\}\\}$"
                  }
                ]
              },
              "story_slug": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^/*,]+(?:/[^/*,]+)*$"
              },
              "review_stage": { "$ref": "#/$defs/nonempty" },
              "workflow": { "$ref": "#/$defs/nonempty" },
              "all_languages": { "const": true },
              "overwrite": { "type": "boolean" },
              "languages": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["lang", "code"],
                  "properties": {
                    "lang": { "$ref": "#/$defs/nonempty" },
                    "code": { "$ref": "#/$defs/nonempty" }
                  }
                }
              }
            }
          }
        },
        "organize_root": {
          "type": "object",
          "description": "Move root stories and folders into a destination, excluding the paths in keep.",
          "additionalProperties": false,
          "required": ["destination", "keep"],
          "properties": {
            "destination": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^/*,]+$"
            },
            "keep": {
              "type": "array",
              "description": "Root folder or story paths to leave in place on each run.",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^/*,]+$"
              }
            }
          }
        },
        "update_matching_blocks": {
          "type": "array",
          "description": "Update fields on every matching component block in a story.",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["story", "component", "where", "fields"],
            "properties": {
              "story": { "$ref": "#/$defs/nonempty" },
              "component": { "$ref": "#/$defs/nonempty" },
              "where": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "equals"],
                "properties": {
                  "field": { "$ref": "#/$defs/nonempty" },
                  "equals": {}
                }
              },
              "fields": { "type": "object", "minProperties": 1 }
            }
          }
        },
        "sync_paths": {
          "type": "array",
          "minItems": 1,
          "description": "Copy a block or component field at the same JSON Pointer path in two stories.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target", "path"],
            "properties": {
              "source": { "$ref": "#/$defs/nonempty" },
              "target": { "$ref": "#/$defs/nonempty" },
              "path": {
                "type": "string",
                "pattern": "^/.+",
                "description": "JSON Pointer into story content; array indices select positions in both stories."
              }
            }
          }
        },
        "sync_blocks": {
          "type": "array",
          "description": "Copy selected block fields from a source story to a target story.",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target", "component", "fields"],
            "properties": {
              "source": { "$ref": "#/$defs/nonempty" },
              "target": { "$ref": "#/$defs/nonempty" },
              "component": { "$ref": "#/$defs/nonempty" },
              "source_uid": { "$ref": "#/$defs/nonempty" },
              "target_uid": { "$ref": "#/$defs/nonempty" },
              "fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/nonempty" }
              }
            }
          }
        },
        "copy": {
          "type": "array",
          "description": "Create independent draft story copies at exact target slugs; existing targets are preserved.",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target"],
            "properties": {
              "source": { "$ref": "#/$defs/nonempty" },
              "target": { "$ref": "#/$defs/nonempty" }
            }
          }
        },
        "create_missing_variants": {
          "type": "array",
          "description": "Create missing linked Dimensions variants for stories under a source path.",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["starts_with"],
            "properties": {
              "starts_with": {
                "$ref": "#/$defs/nonempty",
                "description": "Source folder path, such as global/articles/; descendants are included."
              },
              "folders": {
                "type": "array",
                "description": "Destination Dimensions root folders; omit to select all configured roots except the source.",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^/*,]+$"
                }
              }
            }
          }
        },
        "create_variants": {
          "type": "array",
          "description": "Create linked Dimensions variants for individual stories and destination folders.",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["story", "folder"],
            "properties": {
              "story": { "$ref": "#/$defs/nonempty" },
              "folder": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^/*,]+$"
              }
            }
          }
        },
        "ensure_folders": {
          "type": "array",
          "description": "Ensure story folders exist; nested paths create missing parents.",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/*,]+(?:/[^/*,]+)*$"
          }
        },
        "create": {
          "type": "array",
          "description": "Create draft stories at exact slugs; existing stories are preserved.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "slug", "content"],
            "properties": {
              "name": { "$ref": "#/$defs/nonempty" },
              "release_id": { "type": "integer", "minimum": 1 },
              "release": { "$ref": "#/$defs/nonempty" },
              "slug": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^/*,]+(?:/[^/*,]+)*$"
              },
              "content": {
                "type": "object",
                "required": ["component"],
                "properties": { "component": { "$ref": "#/$defs/nonempty" } },
                "additionalProperties": true
              }
            },
            "not": { "required": ["release", "release_id"] }
          }
        },
        "update_blocks": {
          "type": "array",
          "description": "Update fields on a uniquely matched component block in a story.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["story_slug", "component", "fields"],
            "properties": {
              "story_slug": { "$ref": "#/$defs/nonempty" },
              "component": { "$ref": "#/$defs/nonempty" },
              "release_id": { "type": "integer", "minimum": 1 },
              "release": { "$ref": "#/$defs/nonempty" },
              "fields": { "type": "object", "minProperties": 1 }
            },
            "not": { "required": ["release", "release_id"] }
          }
        },
        "translated_slugs": {
          "type": "array",
          "description": "Ensure translated slugs for selected stories and language codes.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["story_slug", "translations"],
            "properties": {
              "story_slug": { "$ref": "#/$defs/nonempty" },
              "translations": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["slug"],
                  "properties": {
                    "slug": { "$ref": "#/$defs/nonempty" },
                    "name": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "description": "Edit workflow settings and assign stories to stages.",
      "additionalProperties": false,
      "properties": {
        "edit": {
          "type": "array",
          "description": "Update named or ID-selected workflows; renaming requires the workflow ID.",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workflow"],
            "if": { "required": ["name"] },
            "then": { "properties": { "workflow": { "pattern": "^[0-9]+$" } } },
            "anyOf": [
              { "required": ["name"] },
              { "required": ["content_types"] },
              { "required": ["per_language_stages"] }
            ],
            "properties": {
              "workflow": { "$ref": "#/$defs/nonempty" },
              "name": { "$ref": "#/$defs/nonempty" },
              "content_types": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/nonempty" }
              },
              "per_language_stages": {
                "type": "boolean",
                "description": "Enable or disable language-specific workflow stages."
              }
            }
          }
        },
        "assign_unstaged": { "type": "boolean" },
        "stage_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "assign": {
          "type": "array",
          "description": "Assign selected stories to named workflow stages.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stories", "workflow", "stage"],
            "properties": {
              "stories": { "$ref": "#/$defs/selector" },
              "workflow": { "$ref": "#/$defs/nonempty" },
              "stage": { "$ref": "#/$defs/nonempty" }
            }
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "description": "Add tags to selected stories, preserving existing tags.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stories", "tags"],
        "properties": {
          "stories": { "$ref": "#/$defs/selector" },
          "tags": { "$ref": "#/$defs/nonemptyStrings" }
        }
      }
    }
  },
  "$defs": {
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "display_name", "story_slug", "variants", "results"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "display_name": { "$ref": "#/$defs/nonempty" },
        "story_slug": { "$ref": "#/$defs/nonempty" },
        "activate": {
          "type": "boolean",
          "description": "Publish variant stories and start the experiment."
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/experimentVariant" }
        },
        "results": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "series_label"],
          "properties": {
            "title": { "$ref": "#/$defs/nonempty" },
            "series_label": { "$ref": "#/$defs/nonempty" }
          }
        }
      }
    },
    "experimentVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "display_name", "weight", "is_control", "result"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "display_name": { "$ref": "#/$defs/nonempty" },
        "weight": { "type": "number", "minimum": 0, "maximum": 100 },
        "is_control": { "type": "boolean" },
        "result": { "type": "number" }
      }
    },
    "nonempty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "strings": { "type": "array", "items": { "type": "string" } },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "id": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        { "type": "string", "pattern": "^[0-9]*[1-9][0-9]*$" }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slugs"],
      "properties": { "slugs": { "$ref": "#/$defs/nonemptyStrings" } }
    },
    "componentField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "field", "type"],
      "properties": {
        "component": { "$ref": "#/$defs/nonempty" },
        "field": { "$ref": "#/$defs/nonempty" },
        "type": {
          "enum": [
            "text",
            "textarea",
            "richtext",
            "markdown",
            "number",
            "datetime",
            "boolean",
            "option",
            "options",
            "asset",
            "multiasset",
            "multilink",
            "table",
            "bloks",
            "section",
            "custom"
          ]
        },
        "field_type": { "$ref": "#/$defs/nonempty" },
        "tab": { "$ref": "#/$defs/nonempty" },
        "display_name": { "$ref": "#/$defs/nonempty" },
        "required": { "type": "boolean" },
        "translatable": { "type": "boolean" },
        "customize_toolbar": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "custom" } },
            "required": ["type"]
          },
          "then": { "required": ["field_type"] },
          "else": { "not": { "required": ["field_type"] } }
        },
        {
          "if": { "required": ["customize_toolbar"] },
          "then": { "properties": { "type": { "const": "richtext" } } }
        }
      ]
    }
  }
}
